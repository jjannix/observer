# Override the data directory (holds observer.sqlite3). Defaults to %LOCALAPPDATA%\Observer
# OBSERVER_DATA_DIR=

# Override the config file path. Defaults to %APPDATA%\Observer\config.json
# OBSERVER_CONFIG_PATH=

# Port the production server binds to (127.0.0.1 only). Default 4310.
# OBSERVER_PORT=4310

# Vite dev proxy target for the API.
# OBSERVER_API_TARGET=http://127.0.0.1:4310
